# GEO Intelligence Suite — environment configuration template.
# Copy this file to `.env` and fill in whichever keys you have. Every key
# accepts a COMMA-SEPARATED LIST for automatic rotation on rate limits, e.g.
#   GEMINI_API_KEYS=AIzaSy...key1,AIzaSy...key2
# You can also paste keys directly into the Streamlit sidebar instead of
# using this file — either source works, and pasted keys take precedence
# for that session.

# --- Groq / ChatGPT evaluation slot ---------------------------------------
# The app's "ChatGPT" slot calls OpenAI GPT-OSS 120B through Groq.
# Free-tier limits reported for openai/gpt-oss-120b (check your own Groq
# console for current numbers — these are the app's built-in defaults,
# also editable per-run in Advanced settings -> "Rate-limit budgets"):
#   30 requests/minute | 1,000 requests/day
#   8,000 tokens/minute | 200,000 tokens/day
# The app paces calls against BOTH the request and token budgets using the
# real token usage Groq reports per call — not just a fixed delay — since
# 8K TPM is tight enough that a handful of longer (grounded) prompts can
# exhaust it well before the 30 RPM cap does.
GROQ_API_KEYS=
# GROQ_MODEL=openai/gpt-oss-120b

# --- Gemini (Google AI Studio) ---------------------------------------------
# Free, sustained tier, no card required. Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEYS=
# Optional: override the model id if the "latest" alias ever stops resolving
# for your key. See https://ai.google.dev/gemini-api/docs/models
# Gemini model; 3.5 Flash-Lite is a fast/cost-efficient text option.
GEMINI_MODEL=gemini-3.5-flash-lite
# Provider-specific retry/pacing controls. NOTE: as of this build, the
# primary defense against 429s is the smart RPM+TPM rate limiter
# (src/rate_limiter.py, configurable in the app's Advanced settings ->
# "Rate-limit budgets") — GEMINI_MIN_INTERVAL_S below is now only an
# optional EXTRA fixed floor on top of that, useful if you share this key
# with other usage outside this app.
GEMINI_MIN_INTERVAL_S=0
GEMINI_MAX_RETRIES=3
GEMINI_RETRY_BASE_DELAY_S=2.0
GEMINI_RETRY_MAX_DELAY_S=90.0

# --- OpenAI (ChatGPT) --------------------------------------------------------
# No default free tier. Requires opting into OpenAI's free data-sharing
# program on your project (Settings -> Data controls -> Share inputs and
# outputs) to unlock a real daily free token allowance. Your prompts/outputs
# may be used for OpenAI's model training under this program — fine for a
# personal/demo GEO run, wrong for confidential client data. The app's UI
# also requires you to check an explicit opt-in box before this key is used.
OPENAI_API_KEYS=
# OPENAI_MODEL=gpt-5-mini

# --- Claude (Anthropic) — optional, no ongoing free tier --------------------
# Only a one-time ~$5 new-account credit. Disabled by default in the app;
# fill this in only if you have trial or paid credit you want to spend.
ANTHROPIC_API_KEYS=
# CLAUDE_MODEL=claude-haiku-4-5-20251001

# --- Perplexity (Sonar API) — optional, no ongoing free tier ----------------
# Only small one-time trial credits (~$25-50) for new accounts.
PERPLEXITY_API_KEYS=
# PERPLEXITY_MODEL=sonar

# --- Search API (Module A expansion + Module B citation evidence) ----------
# Google's Custom Search JSON API is closed to new signups and being
# discontinued Jan 1 2027 — use one of these instead. You only need one.
# SerpApi: https://serpapi.com/manage-api-key (250 free searches/month, recurring)
SERPAPI_API_KEYS=
# Serper.dev: https://serper.dev/api-key (2,500 free searches, one-time)
SERPER_API_KEYS=

# --- YouTube Data API v3 — Agent 4, bonus 9th xlsx sheet + HTML section ---
# Free Google Cloud API key, ~100 search.list calls/day of quota.
# https://console.cloud.google.com/apis/credentials
# When configured, adds a "Video Intelligence" sheet (top-5 YouTube results
# per tested prompt, with brand-in-title detection) plus an HTML report
# section. Skipped entirely (no error, no sheet added) if left blank —
# your required 8-sheet PRD schema is never affected either way.
YOUTUBE_API_KEYS=
